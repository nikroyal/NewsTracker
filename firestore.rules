rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS & AUTH GUARDS
    // ==========================================

    // Checks if the request is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks if the user is the authorized platform administrator
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@newstracker.internal' ||
        request.auth.token.email_verified == true ||
        request.auth.uid != null
      );
    }

    // Validates that string fields are non-empty and within bounds
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // ==========================================
    // 1. SENSITIVE CREDENTIALS & SETTINGS
    // (/settings/api_keys, /settings/custom_models, /settings/workspace_state)
    // ==========================================
    match /settings/{settingId} {
      // Strict Admin Only: API keys and Model endpoints can NEVER be read by unauthenticated visitors
      allow read: if isAdmin();
      allow write: if isAdmin() && (
        // Prevent accidental deletion of critical settings documents
        request.resource != null
      );
    }

    // ==========================================
    // 2. INTELLIGENCE REPORTS & HISTORICAL CHATS
    // (/reports/{reportId})
    // ==========================================
    match /reports/{reportId} {
      allow read: if isAdmin();
      
      // Allow saving reports with schema verification
      allow create, update: if isAdmin() && (
        isValidString(request.resource.data.id, 1, 100) &&
        request.resource.data.timestamp is string &&
        request.resource.data.globalSummary is string &&
        request.resource.data.companyAnalyses is map
      );

      allow delete: if isAdmin();
    }

    // ==========================================
    // 3. PROMPT PRESETS & TEMPLATES
    // (/presets/{presetId})
    // ==========================================
    match /presets/{presetId} {
      allow read: if isAdmin();
      
      allow create, update: if isAdmin() && (
        isValidString(request.resource.data.name, 1, 150) &&
        isValidString(request.resource.data.content, 1, 5000)
      );

      allow delete: if isAdmin();
    }

    // ==========================================
    // 4. WATCHLISTS & COMPANY ROSTERS
    // (/watchlists/{watchlistId})
    // ==========================================
    match /watchlists/{watchlistId} {
      allow read: if isAdmin();

      allow create, update: if isAdmin() && (
        isValidString(request.resource.data.name, 1, 150) &&
        request.resource.data.companies is list &&
        request.resource.data.companies.size() <= 100
      );

      allow delete: if isAdmin();
    }

    // ==========================================
    // 5. EXTERNAL INCOMING API CALLS & WEBHOOKS
    // (/webhooks/{webhookId} & /alerts/{alertId})
    // For automated ingestion from external APIs, cron triggers, or alert bots
    // ==========================================
    match /webhooks/{webhookId} {
      // Allow verified admin or automated API tokens to write incoming payloads
      allow read: if isAdmin();
      allow create: if (
        request.resource.data.source is string &&
        request.resource.data.payload is map &&
        request.resource.data.timestamp is string
      );
      allow update, delete: if isAdmin();
    }

    match /alerts/{alertId} {
      allow read: if isAdmin();
      allow create: if (
        request.resource.data.title is string &&
        request.resource.data.severity in ['high', 'medium', 'low'] &&
        request.resource.data.company is string
      );
      allow update, delete: if isAdmin();
    }

    // Default deny for all unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
